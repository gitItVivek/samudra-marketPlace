# Multi-stage build: Gradle bootJar → JRE 21
# Build context: repo root

FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /app
ENV GRADLE_OPTS="-Dorg.gradle.daemon=false -Dorg.gradle.parallel=false"
COPY Samudra-backend/ ./
RUN chmod +x gradlew && ./gradlew :samudra-integration:bootJar -x test --no-daemon --stacktrace

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
RUN addgroup -S samudra && adduser -S samudra -G samudra
USER samudra
COPY --from=build /app/samudra-integration/build/libs/samudra-integration.jar /app/app.jar
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
